# B2B Haat — environment template for a LIVE server.
# Copy to .env, fill every value marked REQUIRED, then run `php artisan key:generate`.
# Never commit the real .env. For local development change APP_ENV=local, APP_DEBUG=true, LOG_LEVEL=debug.

APP_NAME="B2B Haat"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# REQUIRED: the public https address, no trailing slash
APP_URL=https://b2bhaat.com
# Set once at first install, before any real orders: changing it later shifts every stored time
# PERF-5: APP_TIMEZONE is how stored times are read and written. New install: UTC. Existing install: keep
# whatever it already uses (check with `php artisan config:show app.timezone`); changing it shifts every stored time.
APP_TIMEZONE=UTC
# What people see in the panels and the timezone of the daily jobs
APP_DISPLAY_TIMEZONE=Asia/Dhaka

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# REQUIRED: PostgreSQL (the app is built and checked against PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=b2bhaat
DB_USERNAME=b2bhaat
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# HTTPS only
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Needs a running worker (`php artisan queue:work`) or no SMS is ever sent
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email is not used for customers yet; `log` keeps any framework mail out of inboxes
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@b2bhaat.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- SMS (BulkSMSBD) ---
SMS_DRIVER=bulksmsbd
SMS_ENABLED=true
# REQUIRED: from your BulkSMSBD account
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=
BULKSMSBD_BASE_URL=https://bulksmsbd.net/api/smsapi
BULKSMSBD_BALANCE_URL=https://bulksmsbd.net/api/getBalanceApi
SMS_OTP_EXPIRY_MINUTES=5
SMS_OTP_LENGTH=6
SMS_OTP_COOLDOWN_SECONDS=60
SMS_OTP_MAX_ATTEMPTS=5
# Must stay EMPTY on a live server (test-only fallback OTP; ignored in production anyway)
SMS_DEFAULT_OTP=

# --- Courier ---
# Shared secret for signed courier status updates. Long random value; only needed once a courier is connected.
COURIER_WEBHOOK_SECRET=
# Courier messages must carry X-Courier-Timestamp (Unix seconds) and X-Courier-Signature = HMAC-SHA256 of "{timestamp}.{body}".
# Messages older than this many seconds, or sent twice, are refused (SEC-11).
COURIER_WEBHOOK_TOLERANCE_SECONDS=300

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SEC-8: days the SMS tracking and invoice links keep working, counted from the order date
ORDER_TRACKING_LINK_DAYS=90
ORDER_INVOICE_LINK_DAYS=365
